# 飞书私人 bot 凭证（在飞书开放平台创建企业自建应用获取）
SELF_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
SELF_FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MiniMax API（用于生成回复）
MINIMAX_API_KEY=eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 千问 API（用于向量 embedding）
QIANWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 数据目录（存放 memories.json、conversations.db、public_bio.md）
DATA_PATH=/home/bots/data

# ChromaDB 向量库路径
CHROMA_PATH=/home/bots/data/chroma_db
